{
  "contract": "diagram-contract-v1",
  "base": {
    "format_version": "behavior-flow-v1", "flow_id": "mq:send", "title": "发送消息", "role": "main",
    "nodes": [{"id": "send", "kind": "entry", "label": "发送"}, {"id": "done", "kind": "exit", "label": "完成"}],
    "edges": [{"source_step_key": "send", "target_step_key": "done"}],
    "paths": [{"path_id": "success", "node_ids": ["send", "done"]}],
    "sequence": {
      "format_version": "sequence-v1", "title": "发送响应", "status": "ready",
      "participants": [{"id": "caller", "label": "调用方"}, {"id": "queue", "label": "队列"}],
      "messages": [
        {"id": "request", "from": "caller", "to": "queue", "kind": "call", "label": "请求发送"},
        {"id": "ok", "from": "queue", "to": "caller", "kind": "return", "label": "发送成功"},
        {"id": "full", "from": "queue", "to": "caller", "kind": "return", "label": "队列已满"},
        {"id": "bad", "from": "queue", "to": "caller", "kind": "return", "label": "非法参数"}
      ],
      "fragments": [{"id": "outcome", "kind": "alt", "label": "请求结果", "operands": [
        {"condition": "非法参数", "message_ids": ["bad"]},
        {"condition": "队列已满", "message_ids": ["full"]},
        {"condition": "成功", "message_ids": ["ok"]}
      ]}], "notes": []
    },
    "call_graph": {
      "format_version": "call-graph-v1", "title": "队列调用", "status": "ready", "root": "send",
      "functions": [{"id": "send", "kind": "function", "label": "mq_send", "signature": "int mq_send(void)", "file": "mq.c", "line": 1}],
      "calls": [], "variables": [{"function": "send", "name": "result", "reads": ["queue.count"], "compute": "count < capacity", "writes": "result", "line": 3}], "notes": []
    }
  },
  "cases": [
    {"name": "legal-branch-order-independent", "strict": true, "patch": [], "expected": []},
    {"name": "missing-new-sequence", "strict": true, "patch": [["sequence", null]], "expected": [["sequence", "sequence", "missing_diagram", "missing"]]},
    {"name": "missing-old-sequence", "strict": false, "patch": [["sequence", null]], "expected": []},
    {"name": "unknown-status", "strict": true, "patch": [["sequence.status", "unknown"]], "expected": [["sequence", "sequence.status", "declared_status", "unknown"]]},
    {"name": "partial-call-graph", "strict": true, "patch": [["call_graph.status", "partial"]], "expected": [["call_graph", "call_graph.status", "declared_status", "unknown"]]},
    {"name": "future-version", "strict": true, "patch": [["sequence.format_version", "sequence-v2"]], "expected": [["sequence", "sequence.format_version", "unsupported_version", "valid_but_unsupported"]]},
    {"name": "unreadable-sequence", "strict": true, "patch": [["sequence", "text"]], "expected": [["sequence", "sequence", "invalid_type", "invalid"]]},
    {"name": "missing-title", "strict": true, "patch": [["sequence.title", null]], "expected": [["sequence", "sequence.title", "missing_field", "missing"]]},
    {"name": "wrong-sequence-kind", "strict": true, "patch": [["sequence.messages.0.kind", "arrow"]], "expected": [["sequence", "sequence.messages[0].kind", "invalid_enum", "invalid"]]},
    {"name": "self-endpoints", "strict": true, "patch": [["sequence.messages.0.kind", "self"]], "expected": [["sequence", "sequence.messages[0].kind", "self_endpoints", "invalid"]]},
    {"name": "unknown-participant", "strict": true, "patch": [["sequence.messages.0.from", "absent"]], "expected": [["sequence", "sequence.messages[0].from", "unknown_reference", "invalid"]]},
    {"name": "unknown-fragment-reference", "strict": true, "patch": [["sequence.fragments.0.operands.0.message_ids", ["absent"]]], "expected": [["sequence", "sequence.fragments[0].operands[0].message_ids[0]", "unknown_reference", "invalid"]]},
    {"name": "overlapping-fragment", "strict": true, "patch": [["sequence.fragments.0.operands.0.message_ids", ["ok"]]], "expected": [["sequence", "sequence.fragments[0].operands[2].message_ids[0]", "overlapping_fragment", "invalid"]]},
    {"name": "noncontiguous-span", "strict": true, "patch": [["sequence.fragments.0.operands", [{"condition": "非法参数", "message_ids": ["bad"]}, {"condition": "成功", "message_ids": ["ok"]}]]], "expected": [["sequence", "sequence.fragments[0].operands", "noncontiguous_fragment", "invalid"]]},
    {"name": "old-writes-array", "strict": false, "patch": [["call_graph.variables.0.writes", ["result", "queue.count"]]], "expected": [["call_graph", "call_graph.variables[0].writes", "legacy_writes_array", "valid_but_unsupported"]]},
    {"name": "new-writes-array", "strict": true, "patch": [["call_graph.variables.0.writes", ["result", "queue.count"]]], "expected": [["call_graph", "call_graph.variables[0].writes", "invalid_type", "invalid"]]},
    {"name": "variable-ref", "strict": true, "patch": [["call_graph.variables.0.function", "absent"]], "expected": [["call_graph", "call_graph.variables[0].function", "unknown_reference", "invalid"]]},
    {"name": "variable-read-type", "strict": true, "patch": [["call_graph.variables.0.reads", [true]]], "expected": [["call_graph", "call_graph.variables[0].reads[0]", "invalid_type", "invalid"]]},
    {"name": "invalid-call", "strict": true, "patch": [["call_graph.calls", [{"from": "send", "to": "absent", "args": [], "returns": "", "file": "mq.c", "line": 0}]]], "expected": [["call_graph", "call_graph.calls[0].to", "unknown_reference", "invalid"], ["call_graph", "call_graph.calls[0].line", "invalid_type", "invalid"]]},
    {"name": "flow-ref", "strict": true, "patch": [["edges.0.target_step_key", "absent"]], "expected": [["flow", "edges[0].target_step_key", "unknown_reference", "invalid"]]},
    {"name": "flow-node-duplicate", "strict": true, "patch": [["nodes", [{"id": "send", "label": "发送"}, {"id": "done", "label": "完成"}, {"id": "send", "label": "发送"}]]], "expected": [["flow", "nodes[2].id", "duplicate_id", "invalid"]]},
    {"name": "flow-path-ref", "strict": true, "patch": [["paths.0.node_ids", ["absent"]]], "expected": [["flow", "paths[0].node_ids[0]", "unknown_reference", "invalid"]]}
  ]
}
