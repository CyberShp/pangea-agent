{
  "$defs": {
    "AnalysisUnit": {
      "additionalProperties": false,
      "properties": {
        "repo_id": {
          "minLength": 1,
          "title": "Repo Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "source_scope": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Scope",
          "type": "array"
        },
        "context_scope": {
          "items": {
            "type": "string"
          },
          "title": "Context Scope",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "asset_item_ids": {
          "items": {
            "type": "string"
          },
          "title": "Asset Item Ids",
          "type": "array"
        },
        "coverage_ids": {
          "items": {
            "type": "string"
          },
          "title": "Coverage Ids",
          "type": "array"
        },
        "mechanism_ids": {
          "items": {
            "type": "string"
          },
          "title": "Mechanism Ids",
          "type": "array"
        },
        "methodology_ids": {
          "items": {
            "type": "string"
          },
          "title": "Methodology Ids",
          "type": "array"
        },
        "methodology_selection_reasons": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Methodology Selection Reasons",
          "type": "object"
        },
        "unit_id": {
          "minLength": 1,
          "title": "Unit Id",
          "type": "string"
        },
        "line_count": {
          "minimum": 0,
          "title": "Line Count",
          "type": "integer"
        },
        "function_count": {
          "minimum": 0,
          "title": "Function Count",
          "type": "integer"
        }
      },
      "required": [
        "repo_id",
        "title",
        "source_scope",
        "rationale",
        "unit_id",
        "line_count",
        "function_count"
      ],
      "title": "AnalysisUnit",
      "type": "object"
    },
    "AtomicCorrectionTarget": {
      "additionalProperties": false,
      "properties": {
        "correction_id": {
          "minLength": 1,
          "title": "Correction Id",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/CorrectionTargetRef"
        },
        "required_state": {
          "minLength": 1,
          "title": "Required State",
          "type": "string"
        }
      },
      "required": [
        "correction_id",
        "target",
        "required_state"
      ],
      "title": "AtomicCorrectionTarget",
      "type": "object"
    },
    "ClosureCorrectionTarget": {
      "additionalProperties": false,
      "properties": {
        "correction_id": {
          "minLength": 1,
          "title": "Correction Id",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/CorrectionTargetRef"
        },
        "required_state": {
          "minLength": 1,
          "title": "Required State",
          "type": "string"
        },
        "finding_key": {
          "minLength": 1,
          "title": "Finding Key",
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/ValueSnapshot"
        }
      },
      "required": [
        "correction_id",
        "target",
        "required_state",
        "finding_key",
        "before"
      ],
      "title": "ClosureCorrectionTarget",
      "type": "object"
    },
    "CorrectionTargetRef": {
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "minLength": 1,
          "title": "Unit Id",
          "type": "string"
        },
        "collection": {
          "enum": [
            "result",
            "flows",
            "input_decisions",
            "branch_decisions",
            "coverage_decisions",
            "mechanism_decisions",
            "risks",
            "scenarios",
            "test_cases"
          ],
          "title": "Collection",
          "type": "string"
        },
        "object_key": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Key"
        },
        "field_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Path"
        }
      },
      "required": [
        "unit_id",
        "collection"
      ],
      "title": "CorrectionTargetRef",
      "type": "object"
    },
    "EvidenceScopeContract": {
      "additionalProperties": false,
      "properties": {
        "repo_id": {
          "minLength": 1,
          "title": "Repo Id",
          "type": "string"
        },
        "allowed_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Paths",
          "type": "array"
        }
      },
      "required": [
        "repo_id",
        "allowed_paths"
      ],
      "title": "EvidenceScopeContract",
      "type": "object"
    },
    "RepositoryRef": {
      "additionalProperties": false,
      "properties": {
        "repo_id": {
          "minLength": 1,
          "title": "Repo Id",
          "type": "string"
        },
        "source_root": {
          "minLength": 1,
          "title": "Source Root",
          "type": "string"
        },
        "git": {
          "additionalProperties": true,
          "title": "Git",
          "type": "object"
        }
      },
      "required": [
        "repo_id",
        "source_root"
      ],
      "title": "RepositoryRef",
      "type": "object"
    },
    "ReviewFinding": {
      "additionalProperties": false,
      "properties": {
        "finding_key": {
          "minLength": 1,
          "title": "Finding Key",
          "type": "string"
        },
        "category": {
          "description": "新增 finding 的类别；blackbox_translation 表示源码事实/风险可能成立，但 Scenario/TestCase 翻译出的业务入口、测试动作、可达路径、Coverage/Risk 追溯或外部 Oracle 不受冻结证据支持；不得写入 independent_finding_decisions.disposition",
          "enum": [
            "missed_flow",
            "document_delta",
            "coverage_gap",
            "defect_mechanism",
            "risk",
            "test_oracle",
            "incorrect_conclusion",
            "blackbox_translation"
          ],
          "title": "Category",
          "type": "string"
        },
        "affected_unit_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Affected Unit Ids",
          "type": "array"
        },
        "linked_input_ids": {
          "items": {
            "type": "string"
          },
          "title": "Linked Input Ids",
          "type": "array"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "required_check": {
          "minLength": 1,
          "title": "Required Check",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "correction_targets": {
          "items": {
            "$ref": "#/$defs/AtomicCorrectionTarget"
          },
          "title": "Correction Targets",
          "type": "array"
        }
      },
      "required": [
        "finding_key",
        "category",
        "affected_unit_ids",
        "summary",
        "required_check",
        "evidence"
      ],
      "title": "ReviewFinding",
      "type": "object"
    },
    "SourceEvidence": {
      "additionalProperties": false,
      "properties": {
        "repo_id": {
          "minLength": 1,
          "title": "Repo Id",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "line_start": {
          "exclusiveMinimum": 0,
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "observation": {
          "description": "必须从当前 repo/path/line_start..line_end 引用范围复制一个连续、逐字符相同的最小源码子串；只放源码文本，不附加解释、推导或范围结论。",
          "minLength": 1,
          "title": "Observation",
          "type": "string"
        }
      },
      "required": [
        "repo_id",
        "path",
        "line_start",
        "observation"
      ],
      "title": "SourceEvidence",
      "type": "object"
    },
    "ValueSnapshot": {
      "additionalProperties": false,
      "properties": {
        "exists": {
          "title": "Exists",
          "type": "boolean"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "exists",
        "value"
      ],
      "title": "ValueSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_type": {
      "const": "closure",
      "default": "closure",
      "title": "Task Type",
      "type": "string"
    },
    "action_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Id"
    },
    "review_contract_version": {
      "default": "1.0",
      "enum": [
        "1.0",
        "2.0"
      ],
      "title": "Review Contract Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "target": {
      "minLength": 1,
      "title": "Target",
      "type": "string"
    },
    "analysis_language": {
      "default": "c_cpp",
      "enum": [
        "c_cpp",
        "lua"
      ],
      "title": "Analysis Language",
      "type": "string"
    },
    "unit": {
      "$ref": "#/$defs/AnalysisUnit"
    },
    "evidence_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceScopeContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "repository": {
      "$ref": "#/$defs/RepositoryRef"
    },
    "original_task_path": {
      "minLength": 1,
      "title": "Original Task Path",
      "type": "string"
    },
    "original_result_path": {
      "minLength": 1,
      "title": "Original Result Path",
      "type": "string"
    },
    "review_findings": {
      "items": {
        "$ref": "#/$defs/ReviewFinding"
      },
      "title": "Review Findings",
      "type": "array"
    },
    "correction_targets": {
      "items": {
        "$ref": "#/$defs/ClosureCorrectionTarget"
      },
      "title": "Correction Targets",
      "type": "array"
    },
    "risk_test_obligations": {
      "items": {
        "type": "string"
      },
      "title": "Risk Test Obligations",
      "type": "array"
    },
    "result_schema_path": {
      "default": "schemas/analysis_result.schema.json",
      "minLength": 1,
      "title": "Result Schema Path",
      "type": "string"
    },
    "result_example_path": {
      "default": "schemas/analysis_result.example.json",
      "minLength": 1,
      "title": "Result Example Path",
      "type": "string"
    },
    "result_contract_path": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Contract Path"
    },
    "result_contract_manifest_path": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Contract Manifest Path"
    },
    "result_path": {
      "minLength": 1,
      "title": "Result Path",
      "type": "string"
    },
    "rubric_paths": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Rubric Paths",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "target",
    "unit",
    "repository",
    "original_task_path",
    "original_result_path",
    "result_path",
    "rubric_paths"
  ],
  "title": "ClosureTask",
  "type": "object"
}
