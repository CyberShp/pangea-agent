{
  "$defs": {
    "ReviewFinding": {
      "additionalProperties": false,
      "properties": {
        "finding_key": {
          "minLength": 1,
          "title": "Finding Key",
          "type": "string"
        },
        "category": {
          "description": "盲审 finding 类别。independent_review 看不到 Analysis Result，因此不能使用 comparison_review 专属的 blackbox_translation",
          "enum": [
            "missed_flow",
            "document_delta",
            "coverage_gap",
            "defect_mechanism",
            "risk",
            "test_oracle",
            "incorrect_conclusion"
          ],
          "title": "Category",
          "type": "string"
        },
        "affected_unit_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Affected Unit Ids",
          "type": "array"
        },
        "linked_input_ids": {
          "items": {
            "type": "string"
          },
          "title": "Linked Input Ids",
          "type": "array"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "required_check": {
          "minLength": 1,
          "title": "Required Check",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "correction_targets": {
          "description": "Independent Review 看不到 Analysis Result，必须为空；由 Comparison Review 对 retained finding 填写原子修正目标",
          "items": {},
          "maxItems": 0,
          "title": "Correction Targets",
          "type": "array"
        }
      },
      "required": [
        "finding_key",
        "category",
        "affected_unit_ids",
        "summary",
        "required_check",
        "evidence"
      ],
      "title": "ReviewFinding",
      "type": "object"
    },
    "SourceEvidence": {
      "additionalProperties": false,
      "properties": {
        "repo_id": {
          "minLength": 1,
          "title": "Repo Id",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "line_start": {
          "exclusiveMinimum": 0,
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "observation": {
          "description": "只陈述当前 repo/path/line_start..line_end 引用范围本身直接证明的源码事实；类型声明若不在引用范围内不得补入，语言标准、Risk 分类、manifest、调用链深度、跨文件缺失、ABI、构建配置和产品入口结论不得伪装成 SourceEvidence observation",
          "minLength": 1,
          "title": "Observation",
          "type": "string"
        }
      },
      "required": [
        "repo_id",
        "path",
        "line_start",
        "observation"
      ],
      "title": "SourceEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ReviewFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "unresolved": {
      "description": "通常必须为空。仅当盲审任务的真实冻结输入本身缺失、无法完成盲审时填写；范围外实现、外部文档、研究问题和低置信度 finding 不得写入。",
      "items": {
        "type": "string"
      },
      "title": "Unresolved",
      "type": "array"
    }
  },
  "required": [
    "summary"
  ],
  "title": "IndependentReviewResult",
  "type": "object"
}
