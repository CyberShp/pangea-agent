{
  "$defs": {
    "AtomicCorrectionTarget": {
      "additionalProperties": false,
      "properties": {
        "correction_id": {
          "minLength": 1,
          "title": "Correction Id",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/CorrectionTargetRef"
        },
        "required_state": {
          "minLength": 1,
          "title": "Required State",
          "type": "string"
        }
      },
      "required": [
        "correction_id",
        "target",
        "required_state"
      ],
      "title": "AtomicCorrectionTarget",
      "type": "object"
    },
    "CorrectionTargetRef": {
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "minLength": 1,
          "title": "Unit Id",
          "type": "string"
        },
        "collection": {
          "enum": [
            "result",
            "flows",
            "input_decisions",
            "branch_decisions",
            "coverage_decisions",
            "mechanism_decisions",
            "risks",
            "scenarios",
            "test_cases"
          ],
          "title": "Collection",
          "type": "string"
        },
        "object_key": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Key"
        },
        "field_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Path"
        }
      },
      "required": [
        "unit_id",
        "collection"
      ],
      "title": "CorrectionTargetRef",
      "type": "object"
    },
    "ReviewFinding": {
      "additionalProperties": false,
      "properties": {
        "finding_key": {
          "minLength": 1,
          "title": "Finding Key",
          "type": "string"
        },
        "category": {
          "description": "新增 finding 的类别；blackbox_translation 表示源码事实/风险可能成立，但 Scenario/TestCase 翻译出的业务入口、测试动作、可达路径、Coverage/Risk 追溯或外部 Oracle 不受冻结证据支持；不得写入 independent_finding_decisions.disposition",
          "enum": [
            "missed_flow",
            "document_delta",
            "coverage_gap",
            "defect_mechanism",
            "risk",
            "test_oracle",
            "incorrect_conclusion",
            "blackbox_translation"
          ],
          "title": "Category",
          "type": "string"
        },
        "affected_unit_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Affected Unit Ids",
          "type": "array"
        },
        "linked_input_ids": {
          "items": {
            "type": "string"
          },
          "title": "Linked Input Ids",
          "type": "array"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "required_check": {
          "minLength": 1,
          "title": "Required Check",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "correction_targets": {
          "items": {
            "$ref": "#/$defs/AtomicCorrectionTarget"
          },
          "title": "Correction Targets",
          "type": "array"
        }
      },
      "required": [
        "finding_key",
        "category",
        "affected_unit_ids",
        "summary",
        "required_check",
        "evidence"
      ],
      "title": "ReviewFinding",
      "type": "object"
    },
    "SourceEvidence": {
      "additionalProperties": false,
      "properties": {
        "repo_id": {
          "minLength": 1,
          "title": "Repo Id",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "line_start": {
          "exclusiveMinimum": 0,
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "observation": {
          "description": "必须从当前 repo/path/line_start..line_end 引用范围复制一个连续、逐字符相同的最小源码子串；只放源码文本，不附加解释、推导或范围结论。",
          "minLength": 1,
          "title": "Observation",
          "type": "string"
        }
      },
      "required": [
        "repo_id",
        "path",
        "line_start",
        "observation"
      ],
      "title": "SourceEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ReviewFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "unresolved": {
      "description": "通常必须为空。仅当盲审任务的真实冻结输入本身缺失、无法完成盲审时填写；范围外实现、外部文档、研究问题和低置信度 finding 不得写入。",
      "items": {
        "type": "string"
      },
      "title": "Unresolved",
      "type": "array"
    }
  },
  "required": [
    "summary"
  ],
  "title": "IndependentReviewResult",
  "type": "object"
}
