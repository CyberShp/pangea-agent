{
  "$defs": {
    "EvidenceScopeContract": {
      "additionalProperties": false,
      "properties": {
        "repo_id": {
          "minLength": 1,
          "title": "Repo Id",
          "type": "string"
        },
        "allowed_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Paths",
          "type": "array"
        }
      },
      "required": [
        "repo_id",
        "allowed_paths"
      ],
      "title": "EvidenceScopeContract",
      "type": "object"
    },
    "SkillTaskContext": {
      "additionalProperties": false,
      "properties": {
        "skill_id": {
          "const": "codetalks-skill",
          "default": "codetalks-skill",
          "title": "Skill Id",
          "type": "string"
        },
        "version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Version",
          "type": "string"
        },
        "derived_from": {
          "const": "codetalks-fused-v2.4",
          "default": "codetalks-fused-v2.4",
          "title": "Derived From",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "root_path": {
          "minLength": 1,
          "title": "Root Path",
          "type": "string"
        },
        "manifest_path": {
          "minLength": 1,
          "title": "Manifest Path",
          "type": "string"
        },
        "integration_path": {
          "minLength": 1,
          "title": "Integration Path",
          "type": "string"
        },
        "stage": {
          "enum": [
            "planning",
            "analysis",
            "review",
            "closure",
            "reporting"
          ],
          "title": "Stage",
          "type": "string"
        },
        "step_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Step Ids",
          "type": "array"
        },
        "step_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Step Paths",
          "type": "array"
        },
        "reference_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reference Paths",
          "type": "array"
        }
      },
      "required": [
        "digest",
        "root_path",
        "manifest_path",
        "integration_path",
        "stage",
        "step_ids",
        "step_paths",
        "reference_paths"
      ],
      "title": "SkillTaskContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_type": {
      "const": "comparison_review",
      "default": "comparison_review",
      "title": "Task Type",
      "type": "string"
    },
    "action_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Id"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "target": {
      "minLength": 1,
      "title": "Target",
      "type": "string"
    },
    "analysis_language": {
      "default": "c_cpp",
      "enum": [
        "c_cpp",
        "lua"
      ],
      "title": "Analysis Language",
      "type": "string"
    },
    "skill": {
      "$ref": "#/$defs/SkillTaskContext"
    },
    "evidence_scope_by_unit": {
      "additionalProperties": {
        "$ref": "#/$defs/EvidenceScopeContract"
      },
      "title": "Evidence Scope By Unit",
      "type": "object"
    },
    "unit_plan_path": {
      "minLength": 1,
      "title": "Unit Plan Path",
      "type": "string"
    },
    "analysis_task_paths": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1,
      "title": "Analysis Task Paths",
      "type": "object"
    },
    "analysis_result_paths": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1,
      "title": "Analysis Result Paths",
      "type": "object"
    },
    "independent_review_result_path": {
      "minLength": 1,
      "title": "Independent Review Result Path",
      "type": "string"
    },
    "selected_inputs_path": {
      "minLength": 1,
      "title": "Selected Inputs Path",
      "type": "string"
    },
    "rubric_paths": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Rubric Paths",
      "type": "array"
    },
    "result_schema_path": {
      "default": "schemas/comparison_review_result.schema.json",
      "minLength": 1,
      "title": "Result Schema Path",
      "type": "string"
    },
    "result_skeleton_path": {
      "default": "schemas/comparison_review_result.skeleton.json",
      "minLength": 1,
      "title": "Result Skeleton Path",
      "type": "string"
    },
    "result_path": {
      "minLength": 1,
      "title": "Result Path",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "target",
    "skill",
    "unit_plan_path",
    "analysis_task_paths",
    "analysis_result_paths",
    "independent_review_result_path",
    "selected_inputs_path",
    "rubric_paths",
    "result_path"
  ],
  "title": "ComparisonReviewTask",
  "type": "object"
}
