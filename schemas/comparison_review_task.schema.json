{
  "$defs": {
    "ComparisonAuditTarget": {
      "additionalProperties": false,
      "properties": {
        "audit_id": {"minLength": 1, "title": "Audit Id", "type": "string"},
        "unit_id": {"minLength": 1, "title": "Unit Id", "type": "string"},
        "object_type": {"minLength": 1, "title": "Object Type", "type": "string"},
        "object_key": {"minLength": 1, "title": "Object Key", "type": "string"},
        "check": {"minLength": 1, "title": "Check", "type": "string"},
        "observed_fields": {
          "additionalProperties": true,
          "description": "Workflow 从 validated Analysis 和对应 Analysis task 原样冻结的待核对字段；仅用于让 Reviewer 直接看到当前值，不代表 Python 已作语义裁决",
          "title": "Observed Fields",
          "type": "object"
        },
        "acceptance_rule": {
          "default": "",
          "description": "Workflow 为当前 object/check 提供的就地核对规则；仅约束 Reviewer 如何裁决，不表示 Python 已判断 observed_fields 的语义正确性",
          "title": "Acceptance Rule",
          "type": "string"
        }
      },
      "required": ["audit_id", "unit_id", "object_type", "object_key", "check"],
      "title": "ComparisonAuditTarget",
      "type": "object"
    },
    "EvidenceScopeContract": {
      "additionalProperties": false,
      "properties": {
        "repo_id": {
          "minLength": 1,
          "title": "Repo Id",
          "type": "string"
        },
        "allowed_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Paths",
          "type": "array"
        }
      },
      "required": [
        "repo_id",
        "allowed_paths"
      ],
      "title": "EvidenceScopeContract",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_type": {
      "const": "comparison_review",
      "default": "comparison_review",
      "title": "Task Type",
      "type": "string"
    },
    "action_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Id"
    },
    "review_contract_version": {
      "default": "1.0",
      "enum": ["1.0", "2.0"],
      "title": "Review Contract Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "target": {
      "minLength": 1,
      "title": "Target",
      "type": "string"
    },
    "analysis_language": {
      "default": "c_cpp",
      "enum": [
        "c_cpp",
        "lua"
      ],
      "title": "Analysis Language",
      "type": "string"
    },
    "evidence_scope_by_unit": {
      "additionalProperties": {
        "$ref": "#/$defs/EvidenceScopeContract"
      },
      "title": "Evidence Scope By Unit",
      "type": "object"
    },
    "unit_plan_path": {
      "minLength": 1,
      "title": "Unit Plan Path",
      "type": "string"
    },
    "analysis_task_paths": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1,
      "title": "Analysis Task Paths",
      "type": "object"
    },
    "analysis_result_paths": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1,
      "title": "Analysis Result Paths",
      "type": "object"
    },
    "required_analysis_audits": {
      "items": {"$ref": "#/$defs/ComparisonAuditTarget"},
      "title": "Required Analysis Audits",
      "type": "array"
    },
    "require_audit_conclusions": {
      "default": false,
      "title": "Require Audit Conclusions",
      "type": "boolean"
    },
    "independent_review_result_path": {
      "minLength": 1,
      "title": "Independent Review Result Path",
      "type": "string"
    },
    "selected_inputs_path": {
      "minLength": 1,
      "title": "Selected Inputs Path",
      "type": "string"
    },
    "rubric_paths": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Rubric Paths",
      "type": "array"
    },
    "result_schema_path": {
      "default": "schemas/comparison_review_result.schema.json",
      "minLength": 1,
      "title": "Result Schema Path",
      "type": "string"
    },
    "result_skeleton_path": {
      "default": "schemas/comparison_review_result.skeleton.json",
      "minLength": 1,
      "title": "Result Skeleton Path",
      "type": "string"
    },
    "result_path": {
      "minLength": 1,
      "title": "Result Path",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "target",
    "unit_plan_path",
    "analysis_task_paths",
    "analysis_result_paths",
    "independent_review_result_path",
    "selected_inputs_path",
    "rubric_paths",
    "result_path"
  ],
  "title": "ComparisonReviewTask",
  "type": "object"
}
