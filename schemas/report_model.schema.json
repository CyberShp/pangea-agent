  "properties": {
    "run_id": {"type": "string"},
    "task_contract": {"type": "object"},
    "module_scope": {"type": "array", "items": {"type": "string"}},
    "repositories": {"type": "array", "items": {"type": "object"}},
    "source_manifest": {"type": "object"},
    "inventory": {"type": "object"},
    "business_flows": {"type": "array", "items": {"$ref": "business_flow.schema.json"}},
    "visual_findings": {"type": "array", "items": {"$ref": "visual_finding.schema.json"}},
    "risks": {"type": "array", "items": {"type": "object"}},
    "test_cases": {"type": "array", "items": {"type": "object"}},
    "coverage_report": {"type": "object"},
    "quality_report": {"type": "object"},
    "errors": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
