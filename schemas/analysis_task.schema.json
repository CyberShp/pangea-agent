{
  "$defs": {
    "AnalysisUnit": {
      "additionalProperties": false,
      "properties": {
        "repo_id": {
          "minLength": 1,
          "title": "Repo Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "source_scope": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Scope",
          "type": "array"
        },
        "context_scope": {
          "items": {
            "type": "string"
          },
          "title": "Context Scope",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "asset_item_ids": {
          "items": {
            "type": "string"
          },
          "title": "Asset Item Ids",
          "type": "array"
        },
        "coverage_ids": {
          "items": {
            "type": "string"
          },
          "title": "Coverage Ids",
          "type": "array"
        },
        "mechanism_ids": {
          "items": {
            "type": "string"
          },
          "title": "Mechanism Ids",
          "type": "array"
        },
        "methodology_ids": {
          "items": {
            "type": "string"
          },
          "title": "Methodology Ids",
          "type": "array"
        },
        "methodology_selection_reasons": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Methodology Selection Reasons",
          "type": "object"
        },
        "unit_id": {
          "minLength": 1,
          "title": "Unit Id",
          "type": "string"
        },
        "line_count": {
          "minimum": 0,
          "title": "Line Count",
          "type": "integer"
        },
        "function_count": {
          "minimum": 0,
          "title": "Function Count",
          "type": "integer"
        }
      },
      "required": [
        "repo_id",
        "title",
        "source_scope",
        "rationale",
        "unit_id",
        "line_count",
        "function_count"
      ],
      "title": "AnalysisUnit",
      "type": "object"
    },
    "EvidenceScopeContract": {
      "additionalProperties": false,
      "properties": {
        "repo_id": {
          "minLength": 1,
          "title": "Repo Id",
          "type": "string"
        },
        "allowed_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Paths",
          "type": "array"
        }
      },
      "required": [
        "repo_id",
        "allowed_paths"
      ],
      "title": "EvidenceScopeContract",
      "type": "object"
    },
    "RepositoryRef": {
      "additionalProperties": false,
      "properties": {
        "repo_id": {
          "minLength": 1,
          "title": "Repo Id",
          "type": "string"
        },
        "source_root": {
          "minLength": 1,
          "title": "Source Root",
          "type": "string"
        },
        "git": {
          "additionalProperties": true,
          "title": "Git",
          "type": "object"
        }
      },
      "required": [
        "repo_id",
        "source_root"
      ],
      "title": "RepositoryRef",
      "type": "object"
    },
    "SkillTaskContext": {
      "additionalProperties": false,
      "properties": {
        "skill_id": {
          "const": "codetalks-skill",
          "default": "codetalks-skill",
          "title": "Skill Id",
          "type": "string"
        },
        "version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Version",
          "type": "string"
        },
        "derived_from": {
          "const": "codetalks-fused-v2.4",
          "default": "codetalks-fused-v2.4",
          "title": "Derived From",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "root_path": {
          "minLength": 1,
          "title": "Root Path",
          "type": "string"
        },
        "manifest_path": {
          "minLength": 1,
          "title": "Manifest Path",
          "type": "string"
        },
        "integration_path": {
          "minLength": 1,
          "title": "Integration Path",
          "type": "string"
        },
        "stage": {
          "enum": [
            "planning",
            "analysis",
            "review",
            "closure",
            "reporting"
          ],
          "title": "Stage",
          "type": "string"
        },
        "step_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Step Ids",
          "type": "array"
        },
        "step_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Step Paths",
          "type": "array"
        },
        "reference_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reference Paths",
          "type": "array"
        }
      },
      "required": [
        "digest",
        "root_path",
        "manifest_path",
        "integration_path",
        "stage",
        "step_ids",
        "step_paths",
        "reference_paths"
      ],
      "title": "SkillTaskContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_type": {
      "const": "analysis",
      "default": "analysis",
      "title": "Task Type",
      "type": "string"
    },
    "action_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Id"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "target": {
      "minLength": 1,
      "title": "Target",
      "type": "string"
    },
    "analysis_language": {
      "default": "c_cpp",
      "enum": [
        "c_cpp",
        "lua"
      ],
      "title": "Analysis Language",
      "type": "string"
    },
    "skill": {
      "$ref": "#/$defs/SkillTaskContext"
    },
    "unit": {
      "$ref": "#/$defs/AnalysisUnit"
    },
    "evidence_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceScopeContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "repository": {
      "$ref": "#/$defs/RepositoryRef"
    },
    "inventory_path": {
      "minLength": 1,
      "title": "Inventory Path",
      "type": "string"
    },
    "source_manifest_path": {
      "minLength": 1,
      "title": "Source Manifest Path",
      "type": "string"
    },
    "selected_inputs_path": {
      "minLength": 1,
      "title": "Selected Inputs Path",
      "type": "string"
    },
    "coverage_context": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Coverage Context",
      "type": "array"
    },
    "result_schema_path": {
      "default": "schemas/analysis_result.schema.json",
      "minLength": 1,
      "title": "Result Schema Path",
      "type": "string"
    },
    "result_skeleton_path": {
      "default": "schemas/analysis_result.skeleton.json",
      "minLength": 1,
      "title": "Result Skeleton Path",
      "type": "string"
    },
    "result_example_path": {
      "default": "schemas/analysis_result.example.json",
      "minLength": 1,
      "title": "Result Example Path",
      "type": "string"
    },
    "result_path": {
      "minLength": 1,
      "title": "Result Path",
      "type": "string"
    },
    "rubric_paths": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Rubric Paths",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "target",
    "skill",
    "unit",
    "repository",
    "inventory_path",
    "source_manifest_path",
    "selected_inputs_path",
    "result_path",
    "rubric_paths"
  ],
  "title": "AnalysisTask",
  "type": "object"
}
