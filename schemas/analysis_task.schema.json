{
  "$defs": {
    "AnalysisUnit": {
      "additionalProperties": false,
      "properties": {
        "repo_id": {
          "minLength": 1,
          "title": "Repo Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "source_scope": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Scope",
          "type": "array"
        },
        "context_scope": {
          "items": {
            "type": "string"
          },
          "title": "Context Scope",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "asset_item_ids": {
          "items": {
            "type": "string"
          },
          "title": "Asset Item Ids",
          "type": "array"
        },
        "coverage_ids": {
          "items": {
            "type": "string"
          },
          "title": "Coverage Ids",
          "type": "array"
        },
        "mechanism_ids": {
          "items": {
            "type": "string"
          },
          "title": "Mechanism Ids",
          "type": "array"
        },
        "unit_id": {
          "minLength": 1,
          "title": "Unit Id",
          "type": "string"
        },
        "line_count": {
          "minimum": 0,
          "title": "Line Count",
          "type": "integer"
        },
        "function_count": {
          "minimum": 0,
          "title": "Function Count",
          "type": "integer"
        }
      },
      "required": [
        "repo_id",
        "title",
        "source_scope",
        "rationale",
        "unit_id",
        "line_count",
        "function_count"
      ],
      "title": "AnalysisUnit",
      "type": "object"
    },
    "RepositoryRef": {
      "additionalProperties": false,
      "properties": {
        "repo_id": {
          "minLength": 1,
          "title": "Repo Id",
          "type": "string"
        },
        "source_root": {
          "minLength": 1,
          "title": "Source Root",
          "type": "string"
        },
        "git": {
          "additionalProperties": true,
          "title": "Git",
          "type": "object"
        }
      },
      "required": [
        "repo_id",
        "source_root"
      ],
      "title": "RepositoryRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_type": {
      "const": "analysis",
      "default": "analysis",
      "title": "Task Type",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "target": {
      "minLength": 1,
      "title": "Target",
      "type": "string"
    },
    "unit": {
      "$ref": "#/$defs/AnalysisUnit"
    },
    "repository": {
      "$ref": "#/$defs/RepositoryRef"
    },
    "inventory_path": {
      "minLength": 1,
      "title": "Inventory Path",
      "type": "string"
    },
    "source_manifest_path": {
      "minLength": 1,
      "title": "Source Manifest Path",
      "type": "string"
    },
    "selected_inputs_path": {
      "minLength": 1,
      "title": "Selected Inputs Path",
      "type": "string"
    },
    "coverage_context": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Coverage Context",
      "type": "array"
    },
    "result_schema_path": {
      "default": "schemas/analysis_result.schema.json",
      "minLength": 1,
      "title": "Result Schema Path",
      "type": "string"
    },
    "result_path": {
      "minLength": 1,
      "title": "Result Path",
      "type": "string"
    },
    "rubric_paths": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Rubric Paths",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "target",
    "unit",
    "repository",
    "inventory_path",
    "source_manifest_path",
    "selected_inputs_path",
    "result_path",
    "rubric_paths"
  ],
  "title": "AnalysisTask",
  "type": "object"
}
