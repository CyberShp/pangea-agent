{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewResult",
  "type": "object",
  "required": ["schema_version", "run_id", "reviewer_id", "finish_reason", "status", "summary", "issues", "reviewed_units", "independent_findings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "reviewer_id": {"type": "string", "minLength": 1},
    "finish_reason": {"enum": ["stop", "truncated", "error"]},
    "status": {"enum": ["PASS", "REWORK", "UNRESOLVED"]},
    "summary": {"type": "string", "minLength": 1},
    "issues": {"type": "array", "items": {"$ref": "review_issue.schema.json"}},
    "reviewed_units": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "independent_findings": {"type": "array", "items": {"type": "object", "required": ["unit_id", "finding", "evidence", "worker_disposition"], "properties": {"unit_id": {"type": "string"}, "finding": {"type": "string"}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "worker_disposition": {"enum": ["covered", "reasonably_excluded", "missing", "contradiction"]}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
