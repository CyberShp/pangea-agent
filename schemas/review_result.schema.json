{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewResult",
  "type": "object",
  "required": ["schema_version", "run_id", "reviewer_id", "finish_reason", "status", "summary", "issues", "reviewed_units", "independent_findings", "test_case_checks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "reviewer_id": {"type": "string", "minLength": 1},
    "finish_reason": {"enum": ["stop", "truncated", "error"]},
    "status": {"enum": ["PASS", "REWORK", "UNRESOLVED"]},
    "summary": {"type": "string", "minLength": 1},
    "issues": {"type": "array", "items": {"$ref": "review_issue.schema.json"}},
    "reviewed_units": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "independent_findings": {"type": "array", "items": {"type": "object", "required": ["unit_id", "finding", "evidence", "worker_disposition", "linked_worker_risk_ids", "linked_worker_test_case_ids"], "properties": {"unit_id": {"type": "string"}, "check_id": {"type": ["string", "null"], "minLength": 1}, "finding": {"type": "string"}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "worker_disposition": {"enum": ["covered", "reasonably_excluded", "missing", "contradiction"]}, "linked_worker_risk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "linked_worker_test_case_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false}},
    "test_case_checks": {"type": "array", "items": {"type": "object", "required": ["unit_id", "test_case_id", "expected_results", "failure_observations", "current_behavior", "verdict", "reason"], "properties": {"unit_id": {"type": "string", "minLength": 1}, "test_case_id": {"type": "string", "minLength": 1}, "expected_results": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "failure_observations": {"type": "array", "minItems": 1, "items": {"type": ["string", "null"], "minLength": 1}}, "current_behavior": {"type": "string", "minLength": 1}, "verdict": {"enum": ["valid", "invalid", "unresolved"]}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
