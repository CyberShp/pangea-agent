{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewResult",
  "type": "object",
  "required": ["schema_version", "run_id", "reviewer_id", "task_digest", "finish_reason", "status", "summary", "issues"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "reviewer_id": {"type": "string", "minLength": 1},
    "task_digest": {"type": "string", "minLength": 64, "maxLength": 64},
    "finish_reason": {"enum": ["stop", "truncated", "error"]},
    "status": {"enum": ["PASS", "REWORK", "UNRESOLVED"]},
    "summary": {"type": "string", "minLength": 1},
    "issues": {"type": "array", "items": {"$ref": "review_issue.schema.json"}}
  },
  "additionalProperties": false
}
