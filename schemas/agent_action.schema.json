{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentAction",
  "type": "object",
  "required": ["action", "role", "stage", "session_key", "unit_id", "task_path", "task_id", "replacement_allowed", "after_completion"],
  "properties": {
    "action": {"enum": ["dispatch_agent", "continue_agent"]},
    "role": {"enum": ["analysis", "review", "rework"]},
    "stage": {"enum": ["source_checkpoint", "risk_analysis", "test_generation", "independent_review", "comparison_review", "rework", "rework_verification"]},
    "session_key": {"type": "string", "minLength": 1},
    "unit_id": {"type": ["string", "null"]},
    "task_path": {"type": "string", "minLength": 1},
    "task_id": {"type": ["string", "null"]},
    "replacement_allowed": {"type": "boolean"},
    "after_completion": {"const": "resume_run"}
  },
  "additionalProperties": false
}
