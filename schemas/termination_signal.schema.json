{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TerminationSignal",
  "type": "object",
  "required": ["schema_version", "run_id", "phase", "reason", "status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "phase": {"enum": ["WAITING_INDEPENDENT_REVIEW", "WAITING_COMPARISON_REVIEW", "WAITING_REWORK", "WAITING_REWORK_VERIFICATION"]},
    "reason": {"type": "string", "minLength": 1},
    "status": {"const": "UNRESOLVED"}
  },
  "additionalProperties": false
}
