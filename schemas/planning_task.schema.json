{
  "$defs": {
    "RepositoryRef": {
      "additionalProperties": false,
      "properties": {
        "repo_id": {
          "minLength": 1,
          "title": "Repo Id",
          "type": "string"
        },
        "source_root": {
          "minLength": 1,
          "title": "Source Root",
          "type": "string"
        },
        "git": {
          "additionalProperties": true,
          "title": "Git",
          "type": "object"
        }
      },
      "required": [
        "repo_id",
        "source_root"
      ],
      "title": "RepositoryRef",
      "type": "object"
    },
    "SkillTaskContext": {
      "additionalProperties": false,
      "properties": {
        "skill_id": {
          "const": "codetalks-skill",
          "default": "codetalks-skill",
          "title": "Skill Id",
          "type": "string"
        },
        "version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Version",
          "type": "string"
        },
        "derived_from": {
          "const": "codetalks-fused-v2.4",
          "default": "codetalks-fused-v2.4",
          "title": "Derived From",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "root_path": {
          "minLength": 1,
          "title": "Root Path",
          "type": "string"
        },
        "manifest_path": {
          "minLength": 1,
          "title": "Manifest Path",
          "type": "string"
        },
        "integration_path": {
          "minLength": 1,
          "title": "Integration Path",
          "type": "string"
        },
        "stage": {
          "enum": [
            "planning",
            "analysis",
            "review",
            "closure",
            "reporting"
          ],
          "title": "Stage",
          "type": "string"
        },
        "step_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Step Ids",
          "type": "array"
        },
        "step_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Step Paths",
          "type": "array"
        },
        "reference_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reference Paths",
          "type": "array"
        }
      },
      "required": [
        "digest",
        "root_path",
        "manifest_path",
        "integration_path",
        "stage",
        "step_ids",
        "step_paths",
        "reference_paths"
      ],
      "title": "SkillTaskContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_type": {
      "const": "unit_planning",
      "default": "unit_planning",
      "title": "Task Type",
      "type": "string"
    },
    "action_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Id"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "target": {
      "minLength": 1,
      "title": "Target",
      "type": "string"
    },
    "analysis_language": {
      "default": "c_cpp",
      "enum": [
        "c_cpp",
        "lua"
      ],
      "title": "Analysis Language",
      "type": "string"
    },
    "skill": {
      "$ref": "#/$defs/SkillTaskContext"
    },
    "repositories": {
      "items": {
        "$ref": "#/$defs/RepositoryRef"
      },
      "minItems": 1,
      "title": "Repositories",
      "type": "array"
    },
    "requested_scope": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Requested Scope",
      "type": "array"
    },
    "compact_metadata_path": {
      "minLength": 1,
      "title": "Compact Metadata Path",
      "type": "string"
    },
    "asset_candidates_path": {
      "minLength": 1,
      "title": "Asset Candidates Path",
      "type": "string"
    },
    "methodology_paths": {
      "items": {
        "type": "string"
      },
      "title": "Methodology Paths",
      "type": "array"
    },
    "methodology_catalog_path": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Methodology Catalog Path"
    },
    "result_schema_path": {
      "default": "schemas/planning_result.schema.json",
      "minLength": 1,
      "title": "Result Schema Path",
      "type": "string"
    },
    "result_skeleton_path": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Skeleton Path"
    },
    "result_example_path": {
      "default": "schemas/planning_result.example.json",
      "minLength": 1,
      "title": "Result Example Path",
      "type": "string"
    },
    "result_path": {
      "minLength": 1,
      "title": "Result Path",
      "type": "string"
    },
    "rubric_paths": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Rubric Paths",
      "type": "array"
    },
    "max_unit_lines": {
      "default": 5000,
      "exclusiveMinimum": 0,
      "title": "Max Unit Lines",
      "type": "integer"
    },
    "max_unit_functions": {
      "default": 140,
      "exclusiveMinimum": 0,
      "title": "Max Unit Functions",
      "type": "integer"
    },
    "merge_direct_call_chain_max_lines": {
      "default": 800,
      "exclusiveMinimum": 0,
      "title": "Merge Direct Call Chain Max Lines",
      "type": "integer"
    },
    "merge_direct_call_chain_max_functions": {
      "default": 30,
      "exclusiveMinimum": 0,
      "title": "Merge Direct Call Chain Max Functions",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "target",
    "skill",
    "repositories",
    "requested_scope",
    "compact_metadata_path",
    "asset_candidates_path",
    "result_path"
  ],
  "title": "PlanningTask",
  "type": "object"
}
