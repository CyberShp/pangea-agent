{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": ["1.0", "2.0"],
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "asset_type": {
      "enum": [
        "requirement",
        "design",
        "historical_defect",
        "reference",
        "coverage",
        "test_case_example"
      ],
      "title": "Asset Type",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "source_path": {
      "minLength": 1,
      "title": "Source Path",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "source_name": {
      "anyOf": [{"type": "string"}, {"type": "null"}],
      "default": null,
      "title": "Source Name"
    },
    "source_sha256": {
      "anyOf": [
        {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        {"type": "null"}
      ],
      "default": null,
      "title": "Source Sha256"
    },
    "source_size": {
      "default": 0,
      "minimum": 0,
      "title": "Source Size",
      "type": "integer"
    },
    "repository_ids": {
      "items": {"type": "string"},
      "type": "array",
      "default": [],
      "title": "Repository Ids"
    },
    "module_tags": {
      "items": {"type": "string"},
      "type": "array",
      "default": [],
      "title": "Module Tags"
    },
    "language_tags": {
      "items": {"type": "string"},
      "type": "array",
      "default": [],
      "title": "Language Tags"
    },
    "created_at": {
      "minLength": 1,
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "minLength": 1,
      "title": "Updated At",
      "type": "string"
    },
    "status": {
      "default": "imported",
      "enum": [
        "imported",
        "extracting",
        "awaiting_review",
        "available",
        "no_items",
        "rejected",
        "failed",
        "archived"
      ],
      "title": "Status",
      "type": "string"
    },
    "review_status": {
      "default": "not_required",
      "enum": [
        "not_required",
        "pending",
        "approved",
        "partially_approved",
        "rejected"
      ],
      "title": "Review Status",
      "type": "string"
    },
    "structured_item_count": {
      "default": 0,
      "minimum": 0,
      "title": "Structured Item Count",
      "type": "integer"
    },
    "extraction_task_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extraction Task Path"
    },
    "normalized_text_path": {
      "anyOf": [{"type": "string"}, {"type": "null"}],
      "default": null,
      "title": "Normalized Text Path"
    },
    "parser_version": {
      "anyOf": [{"type": "string"}, {"type": "null"}],
      "default": null,
      "title": "Parser Version"
    },
    "result_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Path"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "last_error": {
      "anyOf": [{"type": "string"}, {"type": "null"}],
      "default": null,
      "title": "Last Error"
    }
  },
  "required": [
    "asset_id",
    "asset_type",
    "title",
    "source_path",
    "created_at",
    "updated_at"
  ],
  "title": "AssetRecord",
  "type": "object"
}
