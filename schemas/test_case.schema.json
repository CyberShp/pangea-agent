{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestCase",
  "type": "object",
  "required": ["test_case_id", "title", "case_type", "linked_risk_ids", "preconditions", "steps", "expected_results", "observability", "cleanup"],
  "properties": {
    "test_case_id": {"type": "string"},
    "title": {"type": "string"},
    "case_type": {"type": "string", "minLength": 1},
    "linked_risk_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "preconditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expected_results": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "observability": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cleanup": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"type": "string"}
  },
  "additionalProperties": false
}
