{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewTask",
  "type": "object",
  "required": ["schema_version", "run_id", "target", "repositories", "inventory_path", "source_manifest_path", "contract_digest", "task_digest", "stage", "result_path", "analysis_results", "may_spawn_workers", "review_round", "same_reviewer_id", "prior_issues"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "repositories": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["repo_id", "source_root", "git"], "properties": {"repo_id": {"type": "string"}, "source_root": {"type": "string"}, "git": {"type": "object"}}, "additionalProperties": false}},
    "inventory_path": {"type": "string", "minLength": 1},
    "source_manifest_path": {"type": "string", "minLength": 1},
    "contract_digest": {"type": "string", "minLength": 64, "maxLength": 64},
    "task_digest": {"type": "string", "minLength": 64, "maxLength": 64},
    "stage": {"enum": ["initial_review", "rework_verification"]},
    "result_path": {"type": "string", "minLength": 1},
    "analysis_results": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["unit_id", "result_path", "result_digest"], "properties": {"unit_id": {"type": "string"}, "result_path": {"type": "string"}, "result_digest": {"type": "string", "minLength": 64, "maxLength": 64}}, "additionalProperties": false}},
    "may_spawn_workers": {"const": false},
    "review_round": {"const": 1},
    "same_reviewer_id": {"type": ["string", "null"]},
    "prior_issues": {"type": "array", "items": {"$ref": "review_issue.schema.json"}}
  },
  "additionalProperties": false
}
