{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codetalks workbench projection",
  "type": "object",
  "required": ["schema_version", "run_id", "business_flows", "risks", "test_cases", "evidence", "review_issues"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "source_snapshot_digest": {"type": ["string", "null"]},
    "skill_digest": {"type": ["string", "null"]},
    "units": {"type": "array", "items": {"type": "object"}},
    "business_flows": {"type": "array", "items": {"type": "object"}},
    "risks": {"type": "array", "items": {"type": "object"}},
    "test_cases": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "review_issues": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
