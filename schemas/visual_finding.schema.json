{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VisualFinding",
  "type": "object",
  "required": ["attachment_path", "observation"],
  "properties": {
    "attachment_path": {"type": "string", "minLength": 1},
    "observation": {"type": "string", "minLength": 1},
    "status": {"enum": ["confirmed", "pending_confirmation"], "default": "confirmed"},
    "pending_reason": {"type": ["string", "null"], "minLength": 1}
  },
  "additionalProperties": false
}
