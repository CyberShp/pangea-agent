{
  "$defs": {
    "MethodologySelectionRef": {
      "additionalProperties": false,
      "properties": {
        "methodology_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Methodology Id",
          "type": "string"
        },
        "origin": {
          "const": "user",
          "default": "user",
          "title": "Origin",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "source_item_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Item Ids",
          "type": "array"
        },
        "applicable_when": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Applicable When",
          "type": "array"
        },
        "exceptions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Exceptions",
          "type": "array"
        }
      },
      "required": [
        "methodology_id",
        "title",
        "source_item_ids",
        "applicable_when"
      ],
      "title": "MethodologySelectionRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "frozen_at": {
      "format": "date-time",
      "title": "Frozen At",
      "type": "string"
    },
    "enabled_user_methodologies": {
      "items": {
        "$ref": "#/$defs/MethodologySelectionRef"
      },
      "title": "Enabled User Methodologies",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "frozen_at"
  ],
  "title": "FrozenMethodologyCatalog",
  "type": "object"
}
