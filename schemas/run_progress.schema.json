{
  "$defs": {
    "ActionState": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "action_id": {
          "minLength": 1,
          "title": "Action Id",
          "type": "string"
        },
        "action": {
          "enum": [
            "dispatch_agent",
            "continue_agent"
          ],
          "title": "Action",
          "type": "string"
        },
        "role": {
          "enum": [
            "asset_extraction",
            "planning",
            "analysis",
            "review",
            "closure"
          ],
          "title": "Role",
          "type": "string"
        },
        "stage": {
          "enum": [
            "structured_extraction",
            "unit_planning",
            "unit_analysis",
            "independent_review",
            "comparison_review",
            "targeted_closure"
          ],
          "title": "Stage",
          "type": "string"
        },
        "task_path": {
          "minLength": 1,
          "title": "Task Path",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "dispatched",
            "settled",
            "accepted",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "validation_failures": {
          "default": 0,
          "minimum": 0,
          "title": "Validation Failures",
          "type": "integer"
        },
        "repeated_validation_failures": {
          "default": 0,
          "minimum": 0,
          "title": "Repeated Validation Failures",
          "type": "integer"
        },
        "validation_history": {
          "items": {
            "$ref": "#/$defs/ValidationFailureRecord"
          },
          "title": "Validation History",
          "type": "array"
        },
        "incomplete_attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Incomplete Attempts",
          "type": "integer"
        },
        "incomplete_history": {
          "items": {
            "$ref": "#/$defs/ValidationFailureRecord"
          },
          "title": "Incomplete History",
          "type": "array"
        },
        "repair_status": {
          "default": "none",
          "enum": [
            "none",
            "required",
            "dispatched"
          ],
          "title": "Repair Status",
          "type": "string"
        },
        "repair_dispatches": {
          "default": 0,
          "minimum": 0,
          "title": "Repair Dispatches",
          "type": "integer"
        },
        "pending_repair": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepairRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "last_validation_family_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Validation Family Fingerprint"
        },
        "last_validation_detail_count": {
          "default": 0,
          "minimum": 0,
          "title": "Last Validation Detail Count",
          "type": "integer"
        },
        "consecutive_no_progress_failures": {
          "default": 0,
          "minimum": 0,
          "title": "Consecutive No Progress Failures",
          "type": "integer"
        },
        "attention_required": {
          "default": false,
          "title": "Attention Required",
          "type": "boolean"
        }
      },
      "required": [
        "action_id",
        "action",
        "role",
        "stage",
        "task_path"
      ],
      "title": "ActionState",
      "type": "object"
    },
    "AnalysisUnit": {
      "additionalProperties": false,
      "properties": {
        "repo_id": {
          "minLength": 1,
          "title": "Repo Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "source_scope": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Scope",
          "type": "array"
        },
        "context_scope": {
          "items": {
            "type": "string"
          },
          "title": "Context Scope",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "asset_item_ids": {
          "items": {
            "type": "string"
          },
          "title": "Asset Item Ids",
          "type": "array"
        },
        "coverage_ids": {
          "items": {
            "type": "string"
          },
          "title": "Coverage Ids",
          "type": "array"
        },
        "mechanism_ids": {
          "items": {
            "type": "string"
          },
          "title": "Mechanism Ids",
          "type": "array"
        },
        "methodology_ids": {
          "items": {
            "type": "string"
          },
          "title": "Methodology Ids",
          "type": "array"
        },
        "methodology_selection_reasons": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Methodology Selection Reasons",
          "type": "object"
        },
        "unit_id": {
          "minLength": 1,
          "title": "Unit Id",
          "type": "string"
        },
        "line_count": {
          "minimum": 0,
          "title": "Line Count",
          "type": "integer"
        },
        "function_count": {
          "minimum": 0,
          "title": "Function Count",
          "type": "integer"
        }
      },
      "required": [
        "repo_id",
        "title",
        "source_scope",
        "rationale",
        "unit_id",
        "line_count",
        "function_count"
      ],
      "title": "AnalysisUnit",
      "type": "object"
    },
    "RepairRequest": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "exclusiveMinimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "schema_validation",
            "result_contract_validation",
            "incomplete_result"
          ],
          "title": "Kind",
          "type": "string"
        },
        "validation_report_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Report Path"
        },
        "result_contract_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Contract Path"
        },
        "result_sha256": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Sha256"
        },
        "error": {
          "additionalProperties": true,
          "title": "Error",
          "type": "object"
        }
      },
      "required": [
        "attempt",
        "kind"
      ],
      "title": "RepairRequest",
      "type": "object"
    },
    "ValidationErrorGroup": {
      "additionalProperties": false,
      "properties": {
        "group_key": {
          "minLength": 1,
          "title": "Group Key",
          "type": "string"
        },
        "path_pattern": {
          "minLength": 1,
          "title": "Path Pattern",
          "type": "string"
        },
        "error_type": {
          "minLength": 1,
          "title": "Error Type",
          "type": "string"
        },
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "sample_paths": {
          "items": {
            "type": "string"
          },
          "title": "Sample Paths",
          "type": "array"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "unexpected_fields": {
          "items": {
            "type": "string"
          },
          "title": "Unexpected Fields",
          "type": "array"
        }
      },
      "required": [
        "group_key",
        "path_pattern",
        "error_type",
        "count"
      ],
      "title": "ValidationErrorGroup",
      "type": "object"
    },
    "ValidationFailureRecord": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "exclusiveMinimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "detail_count": {
          "default": 0,
          "minimum": 0,
          "title": "Detail Count",
          "type": "integer"
        },
        "group_count": {
          "default": 0,
          "minimum": 0,
          "title": "Group Count",
          "type": "integer"
        },
        "family_fingerprint": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Family Fingerprint"
        },
        "result_sha256": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Sha256"
        },
        "report_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Path"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/ValidationErrorGroup"
          },
          "title": "Groups",
          "type": "array"
        },
        "details": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Details",
          "type": "array"
        },
        "details_truncated": {
          "default": false,
          "title": "Details Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "attempt",
        "code",
        "message"
      ],
      "title": "ValidationFailureRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "3.1",
      "enum": [
        "3.0",
        "3.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "lifecycle_status": {
      "default": "running",
      "enum": [
        "running",
        "complete",
        "stopped",
        "failed"
      ],
      "title": "Lifecycle Status",
      "type": "string"
    },
    "stage": {
      "default": "preparing",
      "enum": [
        "preparing",
        "planning",
        "analyzing",
        "reviewing",
        "closing",
        "reporting",
        "complete"
      ],
      "title": "Stage",
      "type": "string"
    },
    "quality_status": {
      "anyOf": [
        {
          "enum": [
            "PASS",
            "UNRESOLVED"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quality Status"
    },
    "analysis_units": {
      "items": {
        "$ref": "#/$defs/AnalysisUnit"
      },
      "title": "Analysis Units",
      "type": "array"
    },
    "completed_analysis_units": {
      "items": {
        "type": "string"
      },
      "title": "Completed Analysis Units",
      "type": "array"
    },
    "completed_closure_units": {
      "items": {
        "type": "string"
      },
      "title": "Completed Closure Units",
      "type": "array"
    },
    "actions": {
      "additionalProperties": {
        "$ref": "#/$defs/ActionState"
      },
      "title": "Actions",
      "type": "object"
    },
    "degradations": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Degradations",
      "type": "array"
    },
    "errors": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Errors",
      "type": "array"
    },
    "report_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Report Path"
    },
    "html_report_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Html Report Path"
    }
  },
  "required": [
    "run_id"
  ],
  "title": "WorkflowProgress",
  "type": "object"
}
