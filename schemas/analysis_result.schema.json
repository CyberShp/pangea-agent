{
  "$defs": {
    "CodeFlow": {
      "additionalProperties": false,
      "properties": {
        "flow_key": {
          "minLength": 1,
          "title": "Flow Key",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "entry": {
          "minLength": 1,
          "title": "Entry",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/FlowStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/FlowEdge"
          },
          "minItems": 1,
          "title": "Edges",
          "type": "array"
        }
      },
      "required": [
        "flow_key",
        "title",
        "entry",
        "summary",
        "steps",
        "edges"
      ],
      "title": "CodeFlow",
      "type": "object"
    },
    "CoverageDecision": {
      "additionalProperties": false,
      "properties": {
        "coverage_id": {
          "minLength": 1,
          "title": "Coverage Id",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "test_generated",
            "covered_by_generated_case",
            "unreachable",
            "unresolved"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "test_case_keys": {
          "items": {
            "type": "string"
          },
          "title": "Test Case Keys",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "coverage_id",
        "disposition",
        "reason"
      ],
      "title": "CoverageDecision",
      "type": "object"
    },
    "FlowEdge": {
      "additionalProperties": false,
      "properties": {
        "source_step_key": {
          "minLength": 1,
          "title": "Source Step Key",
          "type": "string"
        },
        "target_step_key": {
          "minLength": 1,
          "title": "Target Step Key",
          "type": "string"
        },
        "condition": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        }
      },
      "required": [
        "source_step_key",
        "target_step_key"
      ],
      "title": "FlowEdge",
      "type": "object"
    },
    "FlowStep": {
      "additionalProperties": false,
      "properties": {
        "step_key": {
          "minLength": 1,
          "title": "Step Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "enum": [
            "entry",
            "main",
            "branch",
            "error",
            "propagation",
            "recovery",
            "exit"
          ],
          "title": "Kind",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "step_key",
        "label",
        "kind",
        "evidence"
      ],
      "title": "FlowStep",
      "type": "object"
    },
    "GeneratedTestCase": {
      "additionalProperties": false,
      "properties": {
        "case_key": {
          "minLength": 1,
          "title": "Case Key",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "basis": {
          "items": {
            "enum": [
              "code_flow",
              "coverage",
              "requirement",
              "design",
              "defect_mechanism",
              "risk"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Basis",
          "type": "array"
        },
        "covered_flow_keys": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Covered Flow Keys",
          "type": "array"
        },
        "linked_input_ids": {
          "items": {
            "type": "string"
          },
          "title": "Linked Input Ids",
          "type": "array"
        },
        "linked_risk_keys": {
          "items": {
            "type": "string"
          },
          "title": "Linked Risk Keys",
          "type": "array"
        },
        "level": {
          "enum": [
            "blackbox",
            "graybox"
          ],
          "title": "Level",
          "type": "string"
        },
        "preconditions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Preconditions",
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/TestStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "observability": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Observability",
          "type": "array"
        },
        "cleanup": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Cleanup",
          "type": "array"
        }
      },
      "required": [
        "case_key",
        "title",
        "basis",
        "covered_flow_keys",
        "level",
        "preconditions",
        "steps",
        "observability",
        "cleanup"
      ],
      "title": "GeneratedTestCase",
      "type": "object"
    },
    "InputDecision": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "confirmed",
            "missing_in_code",
            "extra_in_code",
            "mismatch",
            "irrelevant",
            "unresolved"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "conclusion": {
          "minLength": 1,
          "title": "Conclusion",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "disposition",
        "conclusion"
      ],
      "title": "InputDecision",
      "type": "object"
    },
    "MechanismDecision": {
      "additionalProperties": false,
      "properties": {
        "mechanism_id": {
          "minLength": 1,
          "title": "Mechanism Id",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "equivalent_present",
            "blocked",
            "irrelevant",
            "unresolved"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "current_causal_chain": {
          "items": {
            "type": "string"
          },
          "title": "Current Causal Chain",
          "type": "array"
        },
        "test_case_keys": {
          "items": {
            "type": "string"
          },
          "title": "Test Case Keys",
          "type": "array"
        },
        "conclusion": {
          "minLength": 1,
          "title": "Conclusion",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "mechanism_id",
        "disposition",
        "conclusion"
      ],
      "title": "MechanismDecision",
      "type": "object"
    },
    "ReviewFindingDecision": {
      "additionalProperties": false,
      "properties": {
        "finding_key": {
          "minLength": 1,
          "title": "Finding Key",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "incorporated",
            "dismissed",
            "unresolved"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "conclusion": {
          "minLength": 1,
          "title": "Conclusion",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "finding_key",
        "disposition",
        "conclusion"
      ],
      "title": "ReviewFindingDecision",
      "type": "object"
    },
    "RiskFinding": {
      "additionalProperties": false,
      "properties": {
        "risk_key": {
          "minLength": 1,
          "title": "Risk Key",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "dfx": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Dfx",
          "type": "array"
        },
        "severity": {
          "enum": [
            "Low",
            "Medium",
            "High",
            "Critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "trigger": {
          "minLength": 1,
          "title": "Trigger",
          "type": "string"
        },
        "system_result": {
          "minLength": 1,
          "title": "System Result",
          "type": "string"
        },
        "external_observation": {
          "minLength": 1,
          "title": "External Observation",
          "type": "string"
        },
        "exclusion_condition": {
          "minLength": 1,
          "title": "Exclusion Condition",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "test_disposition": {
          "default": "test_required",
          "enum": [
            "test_required",
            "unreachable_from_supported_entry"
          ],
          "title": "Test Disposition",
          "type": "string"
        },
        "unreachable_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unreachable Reason"
        },
        "unreachable_evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "title": "Unreachable Evidence",
          "type": "array"
        }
      },
      "required": [
        "risk_key",
        "title",
        "dfx",
        "severity",
        "confidence",
        "trigger",
        "system_result",
        "external_observation",
        "exclusion_condition",
        "evidence"
      ],
      "title": "RiskFinding",
      "type": "object"
    },
    "SourceEvidence": {
      "additionalProperties": false,
      "properties": {
        "repo_id": {
          "minLength": 1,
          "title": "Repo Id",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "line_start": {
          "exclusiveMinimum": 0,
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "observation": {
          "minLength": 1,
          "title": "Observation",
          "type": "string"
        }
      },
      "required": [
        "repo_id",
        "path",
        "line_start",
        "observation"
      ],
      "title": "SourceEvidence",
      "type": "object"
    },
    "TestStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "expected_result": {
          "minLength": 1,
          "title": "Expected Result",
          "type": "string"
        }
      },
      "required": [
        "action",
        "expected_result"
      ],
      "title": "TestStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "flows": {
      "items": {
        "$ref": "#/$defs/CodeFlow"
      },
      "minItems": 1,
      "title": "Flows",
      "type": "array"
    },
    "input_decisions": {
      "items": {
        "$ref": "#/$defs/InputDecision"
      },
      "title": "Input Decisions",
      "type": "array"
    },
    "coverage_decisions": {
      "items": {
        "$ref": "#/$defs/CoverageDecision"
      },
      "title": "Coverage Decisions",
      "type": "array"
    },
    "mechanism_decisions": {
      "items": {
        "$ref": "#/$defs/MechanismDecision"
      },
      "title": "Mechanism Decisions",
      "type": "array"
    },
    "risks": {
      "items": {
        "$ref": "#/$defs/RiskFinding"
      },
      "title": "Risks",
      "type": "array"
    },
    "test_cases": {
      "items": {
        "$ref": "#/$defs/GeneratedTestCase"
      },
      "title": "Test Cases",
      "type": "array"
    },
    "review_finding_decisions": {
      "items": {
        "$ref": "#/$defs/ReviewFindingDecision"
      },
      "title": "Review Finding Decisions",
      "type": "array"
    },
    "unresolved": {
      "description": "通常必须为空。仅记录真实 selected input ID、Coverage ID 或 confirmed finding_key 在冻结范围内无法完成规定裁决的阻断事项；范围外实现、外部文档、后续研究、低置信度和测试建议不得写入。",
      "items": {
        "type": "string"
      },
      "title": "Unresolved",
      "type": "array"
    }
  },
  "required": [
    "summary",
    "flows"
  ],
  "title": "UnitSemanticResult",
  "type": "object"
}
