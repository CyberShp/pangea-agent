{
  "$defs": {
    "BranchDecision": {
      "additionalProperties": false,
      "properties": {
        "branch_id": {
          "minLength": 1,
          "title": "Branch Id",
          "type": "string"
        },
        "flow_key": {
          "minLength": 1,
          "title": "Flow Key",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "scenario_mapped",
            "merged",
            "not_test_relevant",
            "developer_confirm",
            "unreachable"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "scenario_keys": {
          "items": {
            "type": "string"
          },
          "title": "Scenario Keys",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "branch_id",
        "flow_key",
        "disposition",
        "reason"
      ],
      "title": "BranchDecision",
      "type": "object"
    },
    "CodeFlow": {
      "additionalProperties": false,
      "properties": {
        "flow_key": {
          "minLength": 1,
          "title": "Flow Key",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "entry": {
          "minLength": 1,
          "title": "Entry",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/FlowStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/FlowEdge"
          },
          "minItems": 1,
          "title": "Edges",
          "type": "array"
        }
      },
      "required": [
        "flow_key",
        "title",
        "entry",
        "summary",
        "steps",
        "edges"
      ],
      "title": "CodeFlow",
      "type": "object"
    },
    "CoverageDecision": {
      "additionalProperties": false,
      "properties": {
        "coverage_id": {
          "minLength": 1,
          "title": "Coverage Id",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "scenario_mapped",
            "merged",
            "developer_confirm",
            "unreachable"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "scenario_keys": {
          "items": {
            "type": "string"
          },
          "title": "Scenario Keys",
          "type": "array"
        },
        "test_case_keys": {
          "description": "Workflow 从 test_cases[].direct_coverage_claims 的真实 coverage_id 直接派生；不按 linked_input_ids 或共享 Scenario 扩大关联",
          "items": {
            "type": "string"
          },
          "title": "Test Case Keys",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "coverage_id",
        "disposition",
        "reason"
      ],
      "title": "CoverageDecision",
      "type": "object"
    },
    "CoverageTargetClaim": {
      "additionalProperties": false,
      "properties": {
        "coverage_id": {
          "minLength": 1,
          "title": "Coverage Id",
          "type": "string"
        },
        "target": {
          "enum": [
            "function_execution",
            "branch_true_outcome",
            "branch_false_outcome"
          ],
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "coverage_id",
        "target"
      ],
      "title": "CoverageTargetClaim",
      "type": "object"
    },
    "FlowEdge": {
      "additionalProperties": false,
      "properties": {
        "source_step_key": {
          "description": "必须引用同一 CodeFlow.steps 中已定义的 step_key",
          "minLength": 1,
          "title": "Source Step Key",
          "type": "string"
        },
        "target_step_key": {
          "description": "必须引用同一 CodeFlow.steps 中已定义的 step_key",
          "minLength": 1,
          "title": "Target Step Key",
          "type": "string"
        },
        "condition": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        }
      },
      "required": [
        "source_step_key",
        "target_step_key"
      ],
      "title": "FlowEdge",
      "type": "object"
    },
    "FlowStep": {
      "additionalProperties": false,
      "properties": {
        "step_key": {
          "minLength": 1,
          "title": "Step Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "enum": [
            "entry",
            "main",
            "branch",
            "error",
            "propagation",
            "recovery",
            "exit"
          ],
          "title": "Kind",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "step_key",
        "label",
        "kind",
        "evidence"
      ],
      "title": "FlowStep",
      "type": "object"
    },
    "GeneratedTestCase": {
      "additionalProperties": false,
      "properties": {
        "case_key": {
          "minLength": 1,
          "title": "Case Key",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "basis": {
          "items": {
            "enum": [
              "code_flow",
              "coverage",
              "requirement",
              "design",
              "defect_mechanism",
              "risk"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Basis",
          "type": "array"
        },
        "scenario_keys": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Scenario Keys",
          "type": "array"
        },
        "covered_flow_keys": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Covered Flow Keys",
          "type": "array"
        },
        "linked_input_ids": {
          "description": "仅列此 TestCase 的实际步骤和断言直接覆盖的输入 ID；共享 Scenario 不自动继承其全部输入。其中 Coverage ID 集合必须与 direct_coverage_claims[].coverage_id 集合一致",
          "items": {
            "type": "string"
          },
          "title": "Linked Input Ids",
          "type": "array"
        },
        "direct_coverage_claims": {
          "description": "Agent 对本 TestCase 亲自命中的精确零覆盖目标所作的结构化声明；target 只表示 function 执行或 branch true/false outcome，不从步骤文本推断",
          "items": {
            "$ref": "#/$defs/CoverageTargetClaim"
          },
          "title": "Direct Coverage Claims",
          "type": "array"
        },
        "linked_risk_keys": {
          "items": {
            "type": "string"
          },
          "title": "Linked Risk Keys",
          "type": "array"
        },
        "level": {
          "enum": [
            "blackbox",
            "graybox"
          ],
          "title": "Level",
          "type": "string"
        },
        "preconditions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Preconditions",
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/TestStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "observability": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Observability",
          "type": "array"
        },
        "cleanup": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Cleanup",
          "type": "array"
        }
      },
      "required": [
        "case_key",
        "title",
        "basis",
        "scenario_keys",
        "covered_flow_keys",
        "level",
        "preconditions",
        "steps",
        "observability",
        "cleanup"
      ],
      "title": "GeneratedTestCase",
      "type": "object"
    },
    "InputDecision": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "confirmed",
            "missing_in_code",
            "extra_in_code",
            "mismatch",
            "irrelevant",
            "unresolved"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "conclusion": {
          "minLength": 1,
          "title": "Conclusion",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "disposition",
        "conclusion"
      ],
      "title": "InputDecision",
      "type": "object"
    },
    "MechanismDecision": {
      "additionalProperties": false,
      "properties": {
        "mechanism_id": {
          "minLength": 1,
          "title": "Mechanism Id",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "equivalent_present",
            "blocked",
            "irrelevant",
            "unresolved"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "current_causal_chain": {
          "items": {
            "type": "string"
          },
          "title": "Current Causal Chain",
          "type": "array"
        },
        "test_case_keys": {
          "items": {
            "type": "string"
          },
          "title": "Test Case Keys",
          "type": "array"
        },
        "conclusion": {
          "minLength": 1,
          "title": "Conclusion",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "mechanism_id",
        "disposition",
        "conclusion"
      ],
      "title": "MechanismDecision",
      "type": "object"
    },
    "ReviewFindingDecision": {
      "additionalProperties": false,
      "if": {
        "properties": {
          "disposition": {
            "const": "dismissed"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "properties": {
        "finding_key": {
          "minLength": 1,
          "title": "Finding Key",
          "type": "string"
        },
        "correction_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correction Id"
        },
        "resolved_object_key": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved Object Key"
        },
        "disposition": {
          "enum": [
            "incorporated",
            "dismissed",
            "unresolved"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "conclusion": {
          "minLength": 1,
          "title": "Conclusion",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "finding_key",
        "disposition",
        "conclusion"
      ],
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          }
        },
        "required": [
          "evidence"
        ]
      },
      "title": "ReviewFindingDecision",
      "type": "object"
    },
    "RiskFinding": {
      "additionalProperties": false,
      "properties": {
        "risk_key": {
          "minLength": 1,
          "title": "Risk Key",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "dfx": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Dfx",
          "type": "array"
        },
        "severity": {
          "enum": [
            "Low",
            "Medium",
            "High",
            "Critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "trigger": {
          "minLength": 1,
          "title": "Trigger",
          "type": "string"
        },
        "system_result": {
          "minLength": 1,
          "title": "System Result",
          "type": "string"
        },
        "external_observation": {
          "minLength": 1,
          "title": "External Observation",
          "type": "string"
        },
        "exclusion_condition": {
          "minLength": 1,
          "title": "Exclusion Condition",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "test_disposition": {
          "default": "test_required",
          "enum": [
            "test_required",
            "developer_confirm",
            "unreachable_from_supported_entry"
          ],
          "title": "Test Disposition",
          "type": "string"
        },
        "unreachable_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unreachable Reason"
        },
        "unreachable_evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "title": "Unreachable Evidence",
          "type": "array"
        }
      },
      "required": [
        "risk_key",
        "title",
        "dfx",
        "severity",
        "confidence",
        "trigger",
        "system_result",
        "external_observation",
        "exclusion_condition",
        "evidence"
      ],
      "title": "RiskFinding",
      "type": "object"
    },
    "SourceEvidence": {
      "additionalProperties": false,
      "properties": {
        "repo_id": {
          "minLength": 1,
          "title": "Repo Id",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "line_start": {
          "exclusiveMinimum": 0,
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "observation": {
          "description": "只陈述当前 repo/path/line_start..line_end 引用范围本身直接证明的源码事实；类型声明若不在引用范围内不得补入，语言标准、Risk 分类、manifest、调用链深度、跨文件缺失、ABI、构建配置和产品入口结论不得伪装成 SourceEvidence observation",
          "minLength": 1,
          "title": "Observation",
          "type": "string"
        }
      },
      "required": [
        "repo_id",
        "path",
        "line_start",
        "observation"
      ],
      "title": "SourceEvidence",
      "type": "object"
    },
    "TestScenario": {
      "additionalProperties": false,
      "properties": {
        "scenario_key": {
          "minLength": 1,
          "title": "Scenario Key",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "readiness": {
          "enum": [
            "blackbox_ready",
            "graybox_ready",
            "developer_confirm"
          ],
          "title": "Readiness",
          "type": "string"
        },
        "business_entry": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Business Entry"
        },
        "preconditions": {
          "items": {
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "actions": {
          "items": {
            "type": "string"
          },
          "title": "Actions",
          "type": "array"
        },
        "external_oracles": {
          "items": {
            "type": "string"
          },
          "title": "External Oracles",
          "type": "array"
        },
        "recovery": {
          "items": {
            "type": "string"
          },
          "title": "Recovery",
          "type": "array"
        },
        "covered_flow_keys": {
          "items": {
            "type": "string"
          },
          "title": "Covered Flow Keys",
          "type": "array"
        },
        "branch_ids": {
          "items": {
            "type": "string"
          },
          "title": "Branch Ids",
          "type": "array"
        },
        "coverage_ids": {
          "items": {
            "type": "string"
          },
          "title": "Coverage Ids",
          "type": "array"
        },
        "linked_risk_keys": {
          "items": {
            "type": "string"
          },
          "title": "Linked Risk Keys",
          "type": "array"
        },
        "linked_input_ids": {
          "items": {
            "type": "string"
          },
          "title": "Linked Input Ids",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "scenario_key",
        "title",
        "readiness"
      ],
      "title": "TestScenario",
      "type": "object"
    },
    "TestStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "expected_result": {
          "minLength": 1,
          "title": "Expected Result",
          "type": "string"
        }
      },
      "required": [
        "action",
        "expected_result"
      ],
      "title": "TestStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "flows": {
      "items": {
        "$ref": "#/$defs/CodeFlow"
      },
      "minItems": 1,
      "title": "Flows",
      "type": "array"
    },
    "input_decisions": {
      "items": {
        "$ref": "#/$defs/InputDecision"
      },
      "title": "Input Decisions",
      "type": "array"
    },
    "branch_decisions": {
      "items": {
        "$ref": "#/$defs/BranchDecision"
      },
      "title": "Branch Decisions",
      "type": "array"
    },
    "coverage_decisions": {
      "items": {
        "$ref": "#/$defs/CoverageDecision"
      },
      "title": "Coverage Decisions",
      "type": "array"
    },
    "mechanism_decisions": {
      "items": {
        "$ref": "#/$defs/MechanismDecision"
      },
      "title": "Mechanism Decisions",
      "type": "array"
    },
    "risks": {
      "items": {
        "$ref": "#/$defs/RiskFinding"
      },
      "title": "Risks",
      "type": "array"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/TestScenario"
      },
      "title": "Scenarios",
      "type": "array"
    },
    "test_cases": {
      "items": {
        "$ref": "#/$defs/GeneratedTestCase"
      },
      "title": "Test Cases",
      "type": "array"
    },
    "review_finding_decisions": {
      "items": {
        "$ref": "#/$defs/ReviewFindingDecision"
      },
      "title": "Review Finding Decisions",
      "type": "array"
    },
    "unresolved": {
      "description": "通常必须为空。仅记录真实 selected input ID、Coverage ID 或 confirmed finding_key 在冻结范围内无法完成规定裁决的阻断事项；范围外实现、外部文档、后续研究、低置信度和测试建议不得写入。",
      "items": {
        "type": "string"
      },
      "title": "Unresolved",
      "type": "array"
    }
  },
  "required": [
    "summary",
    "flows"
  ],
  "title": "UnitSemanticResult",
  "type": "object"
}
