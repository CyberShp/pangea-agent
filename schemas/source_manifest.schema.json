{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceManifest",
  "type": "object",
  "properties": {
    "index_path": {"type": "string"},
    "material_index_path": {"type": "string"},
    "file_count": {"type": "integer"},
    "chunk_count": {"type": "integer"},
    "attachments": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "missing_dependencies": {"type": "array", "items": {"type": "object"}},
    "coverage_records": {"type": "array", "items": {"type": "object"}},
    "scope_expansion": {"type": "object"},
    "repository_versions": {"type": "array", "items": {"type": "object"}}
  },
  "required": ["index_path", "material_index_path", "file_count", "chunk_count", "attachments", "warnings", "missing_dependencies", "coverage_records", "scope_expansion", "repository_versions"],
  "additionalProperties": false
}
